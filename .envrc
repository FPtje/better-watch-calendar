use flake

# Keep local.properties in sync with the current Nix SDK store path. Gradle and Android Studio
# prefer sdk.dir over ANDROID_HOME, so a stale path would survive a flake update.
echo "sdk.dir=$ANDROID_HOME" > local.properties

# Untracked per-machine settings: device serials and the debug keystore path.
source_env_if_exists .envrc.local
